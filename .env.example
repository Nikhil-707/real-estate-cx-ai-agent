# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# --- LLM ---
GOOGLE_API_KEY=your-google-genai-api-key-here
GEMINI_MODEL=your-gemini-model-name-here
GEMINI_TEMPERATURE=0.4
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Pinecone (all four are needed) ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=cx-ai-agent-realestate-leadqualifier
PINECONE_INDEX_HOST=your-index-host-url-here
PINECONE_NAMESPACE=__default__

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-telegram-admin-chat-id-here
TELEGRAM_WEBHOOK_SECRET=any-random-string-you-invent

# --- Server / storage / guardrails ---
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_VERIFY_TOKEN=dev-verify-token
SQLITE_DB_PATH=:memory:
SENTIMENT_ESCALATION_THRESHOLD=-0.4
MAX_MESSAGE_LENGTH=2000
