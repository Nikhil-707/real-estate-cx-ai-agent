# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# --- LLM Engine ---
GOOGLE_API_KEY=your-google-genai-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_VERIFY_TOKEN=dev-verify-token

# --- Escalation / Notification ---
ESCALATION_PHONE_NUMBER=+918484820346
NOTIFICATION_WEBHOOK_URL=https://webhook.site/replace-with-your-endpoint
NOTIFICATION_TIMEOUT_SECONDS=5.0

# --- Storage ---
SQLITE_DB_PATH=:memory:
CHROMA_COLLECTION_NAME=dubai_luxury_properties
PINECONE_INDEX_NAME=your-pinecone-index-name-here
PINECONE_API_KEY=your-pinecone-api-key-here

# --- Guardrail Thresholds ---
SENTIMENT_ESCALATION_THRESHOLD=-0.4
MAX_MESSAGE_LENGTH=2000
MAX_TURNS_BEFORE_SOFT_ESCALATION=12

## --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-telegram-admin-chat-id-here
